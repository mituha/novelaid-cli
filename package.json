{
  "name": "novelaid-cli",
  "version": "0.3.0",
  "description": "Novel writing assistant powered by Pi Coding Agent SDK",
  "type": "module",
  "bin": {
    "novelaid": "./bin/novelaid.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "novel",
    "assistant",
    "ai",
    "agent",
    "cli",
    "writing",
    "tui"
  ],
  "author": "Mizuki Mituha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mituha/novelaid-cli.git"
  },
  "homepage": "https://github.com/mituha/novelaid-cli",
  "bugs": {
    "url": "https://github.com/mituha/novelaid-cli/issues"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
